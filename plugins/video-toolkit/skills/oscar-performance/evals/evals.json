{
  "version": "1.5",
  "skill": "oscar-performance",
  "scope": "文字层验证；不含视频生成或成片验收",
  "cases": [
    {
      "id": "T01",
      "type": "create",
      "scenario": "夫妻隔桌争吵；丈夫急着解释，妻子提起旧事；台词和结尾锁定。",
      "must": ["场景共同方向与个人目标分开", "价值错位双方成立", "轴线唯一", "抢话有触发词/重叠/音量", "每拍一个主要心理变化", "禁止提前哭/释然"],
      "fail": ["情绪标签", "轮流念稿", "轴线漂移", "无触发词", "每镜塞满"]
    },
    {
      "id": "T02",
      "type": "create",
      "scenario": "三人场景，A 加入 B/C；需要浅三角、焦点转移、错峰反应。",
      "must": ["站位唯一", "摄影机物理路线", "焦点转移有理由", "光随位置变化", "错峰反应"],
      "fail": ["换位/复制/穿模", "焦点全清楚", "同时反应", "光向不随位置"]
    },
    {
      "id": "T03",
      "type": "create",
      "scenario": "30 秒一镜到底，人物逃跑、上车、车辆加速。",
      "must": ["每次机位变化写怎么走", "事件触发", "世界+画面坐标", "约束具体到米/秒", "禁切镜/瞬移/数字变焦"],
      "fail": ["机位瞬移", "切镜", "无理由绕拍", "方向映射错", "复制车辆"]
    },
    {
      "id": "T04",
      "type": "create",
      "scenario": "阴天海边别墅，男人望海，猫睡在腿上；无台词/旁白/BGM。",
      "must": ["目光/呼吸/小动作推进", "动作对应心理变化", "保留环境声", "不加新事件", "动作/空间连续"],
      "fail": ["硬加台词/旁白/音乐", "静默演成释然", "猫/手瞬移", "无推进"]
    },
    {
      "id": "T05",
      "type": "create_or_revise",
      "scenario": "双人对话，需要抢话、停顿、语言恢复。",
      "must": ["话轮清楚", "重叠有时长", "抢话有明确触发词", "语言受阻匹配心理", "口吃落在难词", "停顿像寻找语言", "语言恢复是保护对方", "悲伤三股力（如适用）"],
      "fail": ["轮流念稿", "无重叠", "口吃平均分布", "抢话无触发", "恢复无原因", "停顿像冻结"]
    },
    {
      "id": "T06",
      "type": "create",
      "scenario": "有角色参考图，要求情绪变化但不换脸。",
      "must": ["写死身份/服装/配饰", "写允许变化项", "情绪不改变身份", "多图用途清楚"],
      "fail": ["只写参考图", "换脸/换装", "无允许变化项", "多图混脸"]
    },
    {
      "id": "T07",
      "type": "create",
      "scenario": "人物从亮区走入屋檐，B/C 在遮阴区；需要反打。",
      "must": ["光源有动机/方向/色温", "移动时光比变化", "反打实际光源不变", "暗部有层次"],
      "fail": ["光源黏脸", "转头重打光", "反打位置改变", "整体偏色"]
    },
    {
      "id": "T08",
      "type": "create_or_revise",
      "scenario": "跨镜场景，有道具、服装、姿势、光向。",
      "must": ["道具状态写清", "姿势/持物/湿润继承", "光向/轴线/视线不跳", "插镜不瞬移"],
      "fail": ["道具重置", "服装变化", "切镜状态重置", "光向跳变"]
    },
    {
      "id": "T09",
      "type": "create",
      "scenario": "只有故事大纲，关键人物关系/前史缺失。",
      "must": ["明写直接用", "强推断标注", "决定性未知只问必要问题", "不暗补", "先做不依赖答案部分"],
      "fail": ["编造前史", "推断写成确定", "问一堆问题", "停止全部工作"]
    },
    {
      "id": "T10",
      "type": "create_or_revise",
      "scenario": "用户要夸张喜剧风格，原稿是克制写实。",
      "must": ["保留用户风格", "不用自然/真实覆盖", "在风格内修不可能动作", "披露冲突"],
      "fail": ["改成克制", "改成外放", "用通用审美覆盖", "不披露"]
    },
    {
      "id": "T11",
      "type": "create_or_audit",
      "scenario": "2 秒镜头，要求站定、走到 10 米外、清晰说完 200 字。",
      "must": ["指出不可同时满足", "不加速/不跳过程/不暗改台词", "给成立部分+待调整约束", "不伪造全套"],
      "fail": ["假装可行", "暗改台词", "加速糊弄", "不披露"]
    },
    {
      "id": "T12",
      "type": "revise_or_audit",
      "scenario": "提示词含跨轴、瞬移、数字变焦、滑行、光源黏脸风险。",
      "must": ["逐项指出风险", "具体修复", "负面清单不长", "区分事实/推测"],
      "fail": ["只写注意一致性", "不指出具体风险", "清单过长", "推测说成事实"]
    },
    {
      "id": "T13",
      "type": "revise",
      "scenario": "已有提示词，只要求改第三镜的表演。",
      "must": ["保留结构/台词/镜头/风格", "只给替换段", "标直接耦合冲突", "不扩写全文"],
      "fail": ["重写全文", "改镜头/台词", "不标冲突", "改变格式"]
    },
    {
      "id": "T14",
      "type": "revise_or_audit",
      "scenario": "原稿轴线矛盾导致视线不可能；光源方向与反打矛盾。",
      "must": ["指出具体句段", "最小修复", "说明代价", "不全面重写"],
      "fail": ["忽略冲突", "全面重写", "不说明代价", "把冲突说成表演问题"]
    },
    {
      "id": "T15",
      "type": "audit",
      "scenario": "两人互相喊情绪、轮流说完台词的提示词。",
      "must": ["五元素逐项判断", "八维关键缺失", "最弱一环只选一个", "最小修复保留用户版本", "干净修复完整成立", "不重写全文"],
      "fail": ["问题无主次", "直接重写", "最弱一环选错", "最小修复改太多"]
    },
    {
      "id": "T16",
      "type": "audit_or_revise",
      "scenario": "只有表情编排，没有人物对对手做什么。",
      "must": ["指出缺 acting task", "先补任务再改证据", "不删原可见动作", "重排因果"],
      "fail": ["继续堆表情", "任务写成抽象情绪", "删掉原细节"]
    },
    {
      "id": "T17",
      "type": "audit_or_create",
      "scenario": "所有角色都在演“家庭的伤”，没有共享方向与个人目标之分。",
      "must": ["指出主题当任务", "补共享方向", "给不同燃料/个人目标", "角色不演主题"],
      "fail": ["继续演同一抽象目标", "主题写进台词", "无个人目标"]
    },
    {
      "id": "T18",
      "type": "create",
      "scenario": "30 秒氛围片，没有明显反转/强 value shift。",
      "must": ["五问逐项判断", "Reversal 写无+理由", "Value Shift 写弱/不适用+理由", "表演不假装转折", "继续交付氛围表演"],
      "fail": ["硬加反转", "硬加 value shift", "虚构结构", "跳过五问"]
    },
    {
      "id": "T19",
      "type": "create_or_revise",
      "scenario": "只有功能台词的双人场景；不改剧情/台词/关系，让人物更丰满。",
      "must": ["挖文本已有动机/矛盾/生活痕迹", "每拍 1–2 个细节绑触发点", "不新增剧情/身世/关系", "不改台词/结局", "细节服务想要/怕/不能说"],
      "fail": ["编前史", "加独白", "堆细节", "改台词", "每镜塞满"]
    },
    {
      "id": "T20",
      "type": "create_or_revise",
      "scenario": "双人对话中丈夫碰倒妻子的杯子；需要表情/肢体变化与连续性。",
      "must": ["物件角色与之前状态", "事件前/中/后/新状态", "表情三股力/第一眼", "肢体链", "物件状态跨镜继承", "AI 负面约束"],
      "fail": ["只写惊讶/尴尬", "物件重置/瞬移", "提前反应", "没有新状态", "物件像纸片"]
    },
    {
      "id": "T21",
      "type": "create",
      "scenario": "30 秒双人文戏，女主开场愤怒、结尾悲伤；要求不直接跳变。",
      "must": ["保护层是可演战术", "底层情绪/真相/代价", "至少 3 道裂缝：触发→重申→泄露→代价", "间隔递进", "失效后有新状态", "证据落在声音/眼神/呼吸/身体/语言"],
      "fail": ["保护层写成形容词", "没有重申/泄露", "裂缝等长", "第一拍就破", "结尾无新状态", "愤怒+哭同时出现"]
    },
    {
      "id": "T22",
      "type": "create_or_revise",
      "scenario": "关键事件（意外/发现/误会/外部事件），要求像真实发生，不是剧情硬拐。",
      "must": ["事件前目的与注意力", "信息差", "环境/路径交叉", "触发点/第一次意识", "反应被目的塑造", "事件改变什么/哪个目的接管", "镜头让观众看见因果链"],
      "fail": ["只写意外/因为", "没有目的/注意力", "没有信息差/环境/路径", "反应千篇一律", "镜头只拍结果不拍原因"]
    }
  ]
}
